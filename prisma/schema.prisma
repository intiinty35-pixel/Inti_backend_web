generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Property {
  id              String            @id @default(cuid())
  slug            String            @unique
  createdByRole   String
  operationType   String
  propertyType    String
  title           String
  description     String
  price           Float
  currency        String
  negotiable      Boolean           @default(false)
  maintenanceFee  Float?
  status          String            @default("PUBLISHED")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactWhatsapp String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  location        PropertyLocation?
  details         PropertyDetails?
  amenities       PropertyAmenity[]
  media           PropertyMedia[]

  @@index([createdAt])
  @@index([operationType, propertyType])
  @@map("properties")
}

model PropertyLocation {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  department          String
  province             String
  district             String
  address              String
  number               String?
  sector               String?
  reference            String?
  latitude             Float?
  longitude            Float?
  approximateLocation  Boolean  @default(true)
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([department, province, district])
  @@map("property_locations")
}

model PropertyDetails {
  id                 String   @id @default(cuid())
  propertyId         String   @unique
  totalArea          Float?
  constructedArea    Float?
  bedrooms           Int?
  bathrooms          Int?
  halfBathrooms      Int?
  parkingSpaces      Int?
  floor              Int?
  floors             Int?
  constructionYear   Int?
  conservationStatus String?
  specificDetails    String?
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model PropertyAmenity {
  propertyId String
  code       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, code])
  @@map("property_amenities")
}

model PropertyMedia {
  id        String   @id @default(cuid())
  propertyId String
  url       String
  publicId  String?
  position  Int      @default(0)
  isCover   Boolean  @default(false)
  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_media")
}
