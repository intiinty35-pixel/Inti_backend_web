generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// PostgreSQL. DATABASE_URL es la conexión de la aplicación (puede pasar por un pooler como el de Supabase);
// DIRECT_URL es una conexión directa o de sesión, que Prisma usa para aplicar migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("USER")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  properties   Property[]
  projects     Project[]
  loginEvents  LoginEvent[]

  @@index([role, createdAt])
  @@map("users")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt, userId])
  @@map("login_events")
}

model Property {
  id              String            @id @default(cuid())
  ownerId         String?
  slug            String            @unique
  createdByRole   String
  operationType   String
  propertyType    String
  title           String
  description     String
  price           Float
  currency        String
  negotiable      Boolean           @default(false)
  maintenanceFee  Float?
  status          String            @default("PUBLISHED")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactWhatsapp String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  location        PropertyLocation?
  details         PropertyDetails?
  amenities       PropertyAmenity[]
  media           PropertyMedia[]
  owner           User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@index([operationType, propertyType])
  @@map("properties")
}

model PropertyLocation {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  department          String
  province            String
  district            String
  address             String
  number              String?
  sector              String?
  reference           String?
  latitude            Float?
  longitude           Float?
  approximateLocation Boolean  @default(true)
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([department, province, district])
  @@map("property_locations")
}

model PropertyDetails {
  id                 String   @id @default(cuid())
  propertyId         String   @unique
  totalArea          Float?
  constructedArea    Float?
  bedrooms           Int?
  bathrooms          Int?
  halfBathrooms      Int?
  parkingSpaces      Int?
  floor              Int?
  floors             Int?
  constructionDate   DateTime?
  conservationStatus String?
  specificDetails    String?
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model PropertyAmenity {
  propertyId String
  code       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, code])
  @@map("property_amenities")
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String?
  position   Int      @default(0)
  isCover    Boolean  @default(false)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_media")
}

model Project {
  id                   String            @id @default(cuid())
  ownerId              String?
  slug                 String            @unique
  name                 String
  description          String
  type                 String
  phase                String
  status               String            @default("DRAFT")
  currency             String            @default("BOB")
  floors               Int?
  startDate            DateTime?
  estimatedDelivery    DateTime?
  constructionProgress Int               @default(0)
  department           String
  province             String
  district             String
  address              String
  urbanization         String?
  reference            String?
  latitude             Float?
  longitude            Float?
  showExactAddress     Boolean           @default(true)
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  contactWhatsapp      String?
  websiteUrl           String?
  ruc                  String?
  socialReason         String?
  initialFee           Float?
  monthlyPayment       Float?
  financingInfo        String?
  totalBlocks          Int?
  hasUrbanization      Boolean           @default(false)
  hasPropertyTitle     Boolean           @default(false)
  viewsCount           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  units                ProjectUnit[]
  media                ProjectMedia[]
  amenities            ProjectAmenity[]
  timeline             ProjectTimeline[]
  comments             ProjectComment[]
  owner                User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([type, phase])
  @@index([department, province, district])
  @@map("projects")
}

model ProjectUnit {
  id           String  @id @default(cuid())
  projectId    String
  unitNumber   String
  type         String
  floor        Int?
  area         Float?
  bedrooms     Int?
  bathrooms    Int?
  parkingSpots Int?
  price        Float?
  status       String  @default("AVAILABLE")
  view         String?
  block        String?
  lotNumber    String?
  frontWidth   Float?
  position     Int     @default(0)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_units")
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  url       String
  publicId  String?
  kind      String  @default("IMAGE")
  position  Int     @default(0)
  isCover   Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_media")
}

model ProjectAmenity {
  id        String  @id @default(cuid())
  projectId String
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_amenities")
}

model ProjectTimeline {
  id          String   @id @default(cuid())
  projectId   String
  phase       String
  date        DateTime
  description String?
  completed   Boolean  @default(false)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@map("project_timeline")
}

model ProjectComment {
  id         String   @id @default(cuid())
  projectId  String
  authorName String
  content    String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_comments")
}

model Inquiry {
  id          String    @id @default(cuid())
  listingType String
  listingId   String
  ownerId     String?
  senderName  String
  senderEmail String
  senderPhone String
  message     String
  status      String    @default("NEW")
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([ownerId, createdAt])
  @@index([listingType, listingId, createdAt])
  @@map("inquiries")
}
