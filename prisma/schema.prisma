generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// PostgreSQL. DATABASE_URL es la conexión de la aplicación (puede pasar por un pooler como el de Supabase);
// DIRECT_URL es una conexión directa o de sesión, que Prisma usa para aplicar migraciones.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String
  role         String       @default("USER")
  isActive     Boolean      @default(true)
  accountStatus String @default("ACTIVE")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  properties   Property[]
  projects     Project[]
  loginEvents  LoginEvent[]
  propertyReviews PropertyReview[]
  paymentOrders PaymentOrder[]
  subscriptions Subscription[]
  favorites     Favorite[]
  notifications Notification[]
  passwordChangedAt DateTime?

  @@index([role, createdAt])
  @@map("users")
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt, userId])
  @@map("login_events")
}

model Property {
  id              String            @id @default(cuid())
  ownerId         String?
  slug            String            @unique
  createdByRole   String
  operationType   String
  propertyType    String
  title           String
  description     String
  price           Float
  currency        String
  negotiable      Boolean           @default(false)
  maintenanceFee  Float?
  status          String            @default("PUBLISHED")
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  contactWhatsapp String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  location        PropertyLocation?
  details         PropertyDetails?
  amenities       PropertyAmenity[]
  media           PropertyMedia[]
  owner           User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  reviews         PropertyReview[]
  isFeatured      Boolean @default(false)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ownerId, createdAt])
  @@index([operationType, propertyType])
  @@map("properties")
}

model PropertyReview {
  id         String @id @default(cuid())
  propertyId String
  userId     String
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@index([propertyId, createdAt])
  @@map("property_reviews")
}

model PropertyLocation {
  id                  String   @id @default(cuid())
  propertyId          String   @unique
  department          String
  province            String
  district            String
  address             String
  number              String?
  sector              String?
  reference           String?
  latitude            Float?
  longitude           Float?
  approximateLocation Boolean  @default(true)
  property            Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([department, province, district])
  @@map("property_locations")
}

model PropertyDetails {
  id                 String   @id @default(cuid())
  propertyId         String   @unique
  totalArea          Float?
  constructedArea    Float?
  bedrooms           Int?
  bathrooms          Int?
  halfBathrooms      Int?
  parkingSpaces      Int?
  floor              Int?
  floors             Int?
  constructionDate   DateTime?
  conservationStatus String?
  specificDetails    String?
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model PropertyAmenity {
  propertyId String
  code       String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, code])
  @@map("property_amenities")
}

model PropertyMedia {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  publicId   String?
  position   Int      @default(0)
  isCover    Boolean  @default(false)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, position])
  @@map("property_media")
}

model Project {
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  id                   String            @id @default(cuid())
  ownerId              String?
  slug                 String            @unique
  name                 String
  description          String
  type                 String
  phase                String
  status               String            @default("DRAFT")
  currency             String            @default("BOB")
  floors               Int?
  startDate            DateTime?
  estimatedDelivery    DateTime?
  constructionProgress Int               @default(0)
  department           String
  province             String
  district             String
  address              String
  urbanization         String?
  reference            String?
  latitude             Float?
  longitude            Float?
  showExactAddress     Boolean           @default(true)
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  contactWhatsapp      String?
  websiteUrl           String?
  ruc                  String?
  socialReason         String?
  initialFee           Float?
  monthlyPayment       Float?
  financingInfo        String?
  totalBlocks          Int?
  hasUrbanization      Boolean           @default(false)
  hasPropertyTitle     Boolean           @default(false)
  viewsCount           Int               @default(0)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  units                ProjectUnit[]
  media                ProjectMedia[]
  amenities            ProjectAmenity[]
  timeline             ProjectTimeline[]
  comments             ProjectComment[]
  owner                User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([ownerId, createdAt])
  @@index([type, phase])
  @@index([department, province, district])
  @@map("projects")
}

model ProjectUnit {
  id           String  @id @default(cuid())
  projectId    String
  unitNumber   String
  type         String
  floor        Int?
  area         Float?
  bedrooms     Int?
  bathrooms    Int?
  parkingSpots Int?
  price        Float?
  status       String  @default("AVAILABLE")
  view         String?
  block        String?
  lotNumber    String?
  frontWidth   Float?
  position     Int     @default(0)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_units")
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  url       String
  publicId  String?
  kind      String  @default("IMAGE")
  position  Int     @default(0)
  isCover   Boolean @default(false)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, position])
  @@map("project_media")
}

model ProjectAmenity {
  id        String  @id @default(cuid())
  projectId String
  name      String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_amenities")
}

model ProjectTimeline {
  id          String   @id @default(cuid())
  projectId   String
  phase       String
  date        DateTime
  description String?
  completed   Boolean  @default(false)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, date])
  @@map("project_timeline")
}

model ProjectComment {
  id         String   @id @default(cuid())
  projectId  String
  authorName String
  content    String
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_comments")
}

model Inquiry {
  id          String    @id @default(cuid())
  listingType String
  listingId   String
  ownerId     String?
  senderName  String
  senderEmail String
  senderPhone String
  message     String
  status      String    @default("NEW")
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([ownerId, createdAt])
  @@index([listingType, listingId, createdAt])
  @@map("inquiries")
}

enum PaymentOrderStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum ManualPaymentType {
  YAPE
  QR_BCP
  BANK_TRANSFER
}

model CommercialPlan {
  id String @id @default(cuid())
  slot Int @unique
  name String
  description String @default("")
  priceBOB Decimal? @db.Decimal(12, 2)
  priceAmount Decimal? @db.Decimal(12, 2)
  priceCurrency String @default("BOB")
  maxProjects Int @default(0)
  archivedAt DateTime?
  durationDays Int @default(30)
  maxProperties Int @default(1)
  maxPhotos Int @default(12)
  featuredLimit Int @default(0)
  benefits String[] @default([])
  displayOrder Int @default(0)
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders PaymentOrder[]
  subscriptions Subscription[]
  @@map("commercial_plans")
}

model BillingSettings {
  id String @id @default("billing")
  bobPerUsd Decimal? @db.Decimal(12, 6)
  orderExpiryHours Int @default(24)
  updatedAt DateTime @updatedAt
  @@map("billing_settings")
}

model ManualPaymentMethod {
  id String @id @default(cuid())
  name String
  type ManualPaymentType @unique
  provider String @default("")
  holder String @default("")
  phone String @default("")
  accountNumber String @default("")
  bankCode String @default("")
  qrImageUrl String @default("")
  currencies String[] @default([])
  instructions String @default("")
  isActive Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders PaymentOrder[]
  @@map("manual_payment_methods")
}

model PaymentOrder {
  id String @id @default(cuid())
  number String @unique
  userId String
  planId String
  methodId String
  status PaymentOrderStatus @default(PENDING)
  currency String
  amountBOB Decimal @db.Decimal(12, 2)
  amountUSD Decimal @db.Decimal(12, 2)
  amount Decimal @db.Decimal(12, 2)
  exchangeRate Decimal @db.Decimal(12, 6)
  planSnapshot Json
  methodSnapshot Json
  rejectionReason String?
  reviewedBy String?
  reviewedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan CommercialPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  method ManualPaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  receipts PaymentReceipt[]
  subscription Subscription?
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@index([planId, methodId, currency, createdAt])
  @@map("payment_orders")
}

model PaymentReceipt {
  id String @id @default(cuid())
  orderId String
  fileKey String @unique
  originalName String
  mimeType String
  size Int
  createdAt DateTime @default(now())
  order PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@map("payment_receipts")
}

model Subscription {
  id String @id @default(cuid())
  userId String
  planId String
  orderId String? @unique
  source String @default("MANUAL")
  maxProjects Int @default(0)
  status SubscriptionStatus @default(PENDING)
  startsAt DateTime
  expiresAt DateTime
  cancelledAt DateTime?
  planName String
  maxProperties Int
  maxPhotos Int
  featuredLimit Int
  planSnapshot Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan CommercialPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  order PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  properties Property[]
  projects Project[]
  @@index([userId, status, expiresAt])
  @@map("subscriptions")
}

model BillingAudit {
  id String @id @default(cuid())
  actorId String
  userId String?
  resourceId String
  action String
  category String @default("SYSTEM")
  actorName String?
  actorEmail String?
  actorRole String?
  subjectName String?
  resourceName String?
  ipAddress String?
  userAgent String?
  device String?
  requestId String?
  httpMethod String?
  path String?
  statusCode Int?
  success Boolean @default(true)
  metadata Json?
  reason String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([resourceId, createdAt])
  @@index([userId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorRole, createdAt])
  @@index([category, createdAt])
  @@index([requestId])
  @@index([createdAt, id])
  @@index([action, createdAt])
  @@map("billing_audit")
}

model NotificationOutbox {
  id String @id @default(cuid())
  eventKey String @unique
  recipient String
  subject String
  text String
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt DateTime?
  sentAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

// Publicaciones (propiedades o proyectos) que una persona guarda para volver a verlas.
model Favorite {
  id          String   @id @default(cuid())
  userId      String
  listingType String
  listingId   String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingType, listingId])
  @@index([userId, createdAt])
  @@index([listingType, listingId])
  @@map("favorites")
}

// Avisos dentro de la plataforma (campana): alguien guardó tu publicación, recibiste una consulta, etc.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  message    String
  actionUrl  String?
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@index([type, entityId, createdAt])
  @@map("notifications")
}

model ComplaintBookEntry {
  id                  String   @id @default(cuid())
  ticketNumber        String   @unique
  claimantFirstName   String
  claimantLastName    String   @default("")
  claimantEmail       String
  claimantPhone       String
  documentType        String   @default("OTHER")
  documentNumber      String?
  department          String   @default("")
  municipality        String   @default("")
  address             String   @default("")
  entryType           String
  serviceDescription  String
  transactionNumber   String?
  incidentDate        DateTime? @db.Date
  detail              String
  desiredResolution   String?
  createdAt           DateTime @default(now())
  attachments         ComplaintAttachment[]

  @@index([createdAt])
  @@index([claimantEmail, createdAt])
  @@map("complaint_book_entries")
}

model ComplaintAttachment {
  id            String            @id @default(cuid())
  complaintId   String
  fileKey       String            @unique
  originalName  String
  mimeType      String
  size          Int
  createdAt     DateTime          @default(now())
  complaint     ComplaintBookEntry @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
  @@map("complaint_attachments")
}
