NODE_ENV=development
API_PORT=3001

# Origen del frontend permitido por CORS (varios separados por coma).
FRONTEND_ORIGIN=http://localhost:3000
# Dirección pública del frontend; solo la usan los seeds para las imágenes de ejemplo.
FRONTEND_PUBLIC_URL=http://localhost:3000

# PostgreSQL local: docker compose up -d db
# DATABASE_URL es la conexión de la aplicación y DIRECT_URL la que Prisma usa para migrar; en local son la misma.
# Con Supabase en modo transacción (puerto 6543) añade ?pgbouncer=true&connection_limit=1 a DATABASE_URL
# y usa la conexión directa o de sesión (puerto 5432) en DIRECT_URL.
DATABASE_URL="postgresql://inti:inti@localhost:5433/inti"
DIRECT_URL="postgresql://inti:inti@localhost:5433/inti"

ADMIN_EMAIL=admin@inti.local
ADMIN_PASSWORD=replace-with-a-local-demo-password

# Cadena aleatoria de al menos 32 caracteres para firmar las sesiones.
AUTH_SECRET=

# Cloudinary: aquí se guardan las imágenes que se suben (no se guardan en el disco del servidor).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa a las tres variables anteriores. Debe empezar por cloudinary:// (no repitas el nombre de la variable):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
