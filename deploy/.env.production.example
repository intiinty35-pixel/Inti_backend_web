# Plantilla del .env del servidor. NO la edites a mano desde cero: `sh deploy/init-env.sh` crea el .env a partir de
# ella, genera las claves y arma las URLs de la base de datos. Solo tienes que completar lo que quede marcado.
# El .env no se sube a git (chmod 600). Si falta o es inválido algo obligatorio, la API no arranca y el motivo
# queda en `docker compose -f deploy/docker-compose.yml logs backend`.

NODE_ENV=production

# ── Base de datos (PostgreSQL en este mismo servidor, contenedor "db") ──
# init-env.sh genera POSTGRES_PASSWORD una sola vez y deriva de ella DATABASE_URL y DIRECT_URL.
# No cambies POSTGRES_PASSWORD después del primer despliegue: la base ya se creó con esa contraseña.
POSTGRES_USER=inti
POSTGRES_DB=inti
POSTGRES_PASSWORD=
DATABASE_URL=
DIRECT_URL=

# ── Sitio ──
# Origen del frontend permitido por CORS (varios separados por coma). Sin barra final ni ruta.
FRONTEND_ORIGIN=https://intinmobiliaria.com
# Dirección pública del frontend; solo la usan los seeds para las imágenes de ejemplo.
FRONTEND_PUBLIC_URL=https://intinmobiliaria.com

# ── Cuenta administradora (completar) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Cadena aleatoria para firmar las sesiones; init-env.sh la genera si está vacía.
AUTH_SECRET=

# ── Cloudinary: almacenamiento de imágenes (completar) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
