# Copiar a .env en la raíz del backend en el servidor y proteger con chmod 600. NO subir a git.
# Si falta o es inválido algo obligatorio, la API no arranca y el motivo queda en `docker compose logs backend`.

NODE_ENV=production

# ── Base de datos (PostgreSQL, p. ej. Supabase) ──
# DATABASE_URL: conexión de la aplicación. Con el pooler en modo transacción (puerto 6543) hay que añadir
#   ?pgbouncer=true&connection_limit=1
# DIRECT_URL: conexión directa o de sesión (puerto 5432), que Prisma usa para aplicar las migraciones al arrancar.
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres"

# ── Sitio ──
# Origen del frontend permitido por CORS (varios separados por coma). Sin barra final ni ruta.
FRONTEND_ORIGIN=https://intinmobiliaria.com
# Dirección pública del frontend; solo la usan los seeds para las imágenes de ejemplo.
FRONTEND_PUBLIC_URL=https://intinmobiliaria.com

# ── Cuenta administradora ──
ADMIN_EMAIL=admin@intinmobiliaria.com
ADMIN_PASSWORD=
# Cadena aleatoria de al menos 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# ── Cloudinary (almacenamiento de imágenes) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternativa a las tres variables anteriores. Debe empezar por cloudinary:// (no repetir el nombre de la variable):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
