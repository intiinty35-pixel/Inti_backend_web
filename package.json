{
  "name": "inti-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node --env-file=.env prisma/seed-demo.cjs",
    "db:seed:projects": "node --env-file=.env prisma/seed-projects.cjs",
    "db:seed:users": "node --env-file=.env prisma/seed-users.cjs",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config test/jest-e2e.config.cjs --runInBand",
    "test:billing:integration": "node --env-file=.env scripts/test-billing-integration.cjs",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@prisma/client": "6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "helmet": "^8.3.0",
    "multer": "2.5.0",
    "nodemailer": "^10.3.1",
    "prisma": "6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  }
}
